package="agg-api-dsm"
version="0.2.0-0001"
os_min_ver="7.0-40000"
# x86_64 而非 noarch：包里只有一个 linux/amd64 二进制。声明 noarch 会让
# 套件中心在 ARM 机型（DS223 等）上也提供安装，装完二进制 exec 失败、
# 套件永久停在「已停用」——上游 M365-Copilot2API 踩过这个坑，这里沿用结论。
arch="x86_64"
displayname="Agg-API-DSM"
description="Agg-API-DSM 本地网关（群晖 DSM 版）。一个套件同时提供两个上游：Agnes AI 与 M365 Copilot。下游只认一个地址、一个 API Key，由模型名决定走哪条链路（agnes-* / copilot-*）。两个上游共用同一套账号池与 RPM 限流节拍：账号轮换、失败冷却、按负载选账号都是共享的。自带 Web 管理控制台：上游状态、账号管理（Copilot 走浏览器授权，无需设备码）、下游 API Key 管理。服务端口 4444，安装向导可设置管理员口令。升级请在套件中心安装新版 SPK。"
maintainer="kosje"
maintainer_url="https://github.com/kosje/Agg-API-DSM"
support_url="https://github.com/kosje/Agg-API-DSM/issues"
thirdparty="yes"
startable="yes"
silent_install="no"
silent_upgrade="no"
silent_uninstall="no"
install_reboot="no"
adminport="4444"
adminprotocol="http"
adminurl="/"
dsmuidir="ui"
dsmappname="com.kosje.aggapi"
reloadui="yes"
